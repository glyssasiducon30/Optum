                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox354">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Sum(Fields!Handled_Actual_Contacts.Value) = 0, 0, Sum(Fields!ASA_Calc.Value) / Sum(Fields!Handled_Actual_Contacts.Value))</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <Format>0;(0)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox349</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>Tan</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox453">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(
(Sum(Fields!Handled_Actual_Contacts.Value) = 0 
OR (Sum(Fields!AHT_Calc.Value) + Sum(Fields!Avail.Value)) = 0), 
Nothing, 
(((Sum(Fields!Handled_Actual_Contacts.Value) *
(IIF(Sum(Fields!Handled_Actual_Contacts.Value) = 0, 0, Sum(Fields!AHT_Calc.Value) / Sum(Fields!Handled_Actual_Contacts.Value)))) 
/
(IIF((Sum(Fields!AHT_Calc.Value) + Sum(Fields!Avail.Value)) = 0, 0, Sum(Fields!AHT_Calc.Value) / (Sum(Fields!AHT_Calc.Value) + Sum(Fields!Avail.Value))))
) 
- 
(Sum(Fields!Handled_Actual_Contacts.Value) * 
(IIF(Sum(Fields!Handled_Actual_Contacts.Value) = 0, 0, Sum(Fields!AHT_Calc.Value) / Sum(Fields!Handled_Actual_Contacts.Value))))
)
)</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <Format>0;(0)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox353</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>Tan</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
