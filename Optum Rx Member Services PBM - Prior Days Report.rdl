  <DataSets>
    <DataSet Name="dsStartDate">
      <Query>
        <DataSourceName>dsource</DataSourceName>
        <CommandText>  DECLARE @StartDate AS DATE
  SET @StartDate = CAST(DATEADD(month, DATEDIFF(month, 0, GETDATE()), 0) AS DATE)
  IF DATEPART(DAY,@StartDate) = 1
	BEGIN
		 SELECT CAST(CAST(CAST(DATEADD(month, DATEDIFF(month, 0, GETDATE() -1), 0) AS DATE) AS DATETIME) AS DATE) AS StartDate
	END
ELSE
	BEGIN
		SELECT CAST(CAST(@StartDate AS DATETIME) - 1 AS DATE) AS StartDate
	END</CommandText>
      </Query>
      <Fields>
        <Field Name="StartDate">
          <DataField>StartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsEndDate">
      <Query>
        <DataSourceName>dsource</DataSourceName>
        <CommandText>declare @mydate date=DATEADD(d, -1, GETUTCDATE())
SELECT @mydate as EndDate;</CommandText>
      </Query>
      <Fields>
        <Field Name="EndDate">
          <DataField>EndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds2">
      <Query>
        <DataSourceName>dsource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EXEC [dbo].[Spotlight_PriorDaysReport_MemberServices_PBM_ForRDL]

	@StartDate,
	@EndDate,
	'Summary'</CommandText>
      </Query>
