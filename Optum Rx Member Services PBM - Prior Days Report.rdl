                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(
(Sum(Fields!Handled_Actual_Contacts.Value) = 0 
OR (Sum(Fields!AHT_Calc.Value) + Sum(Fields!Avail.Value)) = 0), 
Nothing, 
(((Sum(Fields!Handled_Actual_Contacts.Value) *
(IIF(Sum(Fields!Handled_Actual_Contacts.Value) = 0, 0, Sum(Fields!AHT_Calc.Value) / Sum(Fields!Handled_Actual_Contacts.Value)))) 
/
(IIF((Sum(Fields!AHT_Calc.Value) + Sum(Fields!Avail.Value)) = 0, 0, Sum(Fields!AHT_Calc.Value) / (Sum(Fields!AHT_Calc.Value) + Sum(Fields!Avail.Value))))
) 
- 
(Sum(Fields!Handled_Actual_Contacts.Value) * 
(IIF(Sum(Fields!Handled_Actual_Contacts.Value) = 0, 0, Sum(Fields!AHT_Calc.Value) / Sum(Fields!Handled_Actual_Contacts.Value))))
)
)</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <Format>0;(0)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
