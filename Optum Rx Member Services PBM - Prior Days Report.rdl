                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(Sum(Fields!D_SHRINKAGE.Value) = 0, 0, Sum(Fields!N_OOO.Value) / iif(Sum(Fields!D_SHRINKAGE.Value) = 0, 1, Sum(Fields!D_SHRINKAGE.Value)))</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <Format>0.00%</Format>
