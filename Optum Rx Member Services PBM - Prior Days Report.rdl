                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(
(Sum(Fields!Calls_Handled.Value) = 0 OR 
(Sum(Fields!n_average_handle_time_Occupancy.Value) + Sum(Fields!Ready_Time_Occupancy.Value)) = 0), 
Nothing, 
(
(
Sum(Fields!Calls_Handled.Value) * 
(IIF(Sum(Fields!Calls_Handled.Value) = 0, 0, 
Sum(Fields!n_average_handle_time.Value) / Sum(Fields!Calls_Handled.Value)))
) 
/ 
(IIF((Sum(Fields!n_average_handle_time_Occupancy.Value) + Sum(Fields!Ready_Time_Occupancy.Value)) = 0, 0, 
Sum(Fields!n_average_handle_time_Occupancy.Value) / 
(Sum(Fields!n_average_handle_time_Occupancy.Value) + Sum(Fields!Ready_Time_Occupancy.Value)))
) 
- 
(
Sum(Fields!Calls_Handled.Value) * 
(IIF(Sum(Fields!Calls_Handled.Value) = 0, 0, 
Sum(Fields!n_average_handle_time.Value) / Sum(Fields!Calls_Handled.Value)))
)
)
)</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <Format>0;(0)</Format>
                                  </Style>
                                </TextRun>
