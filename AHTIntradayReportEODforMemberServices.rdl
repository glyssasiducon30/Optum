  <DataSets>
    <DataSet Name="dsDate">
      <Query>
        <DataSourceName>AHT_Intraday_OptumRx_MS</DataSourceName>
        <CommandText>declare @mydate date=(SELECT MAX(Day) FROM dbo.GenesysAgentAHTReportForOptumRxView (NOLOCK))

SELECT DATEADD(month, DATEDIFF(month, 0, @mydate), 0) AS Date</CommandText>
      </Query>
      <Fields>
        <Field Name="Date">
          <DataField>Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsSupervisor">
      <Query>
        <DataSourceName>AHT_Intraday_OptumRx_MS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@fnLOB">
            <Value>=Parameters!fnLOB.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT [VALUE] as Supervisor
FROM SpotLight_AdherencePrepareMasterDataForFilter
WHERE [KEY]='Supervisor' AND FN_LOB IN (@fnLOB)
ORDER BY [VALUE]</CommandText>
      </Query>
      <Fields>
        <Field Name="Supervisor">
          <DataField>Supervisor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
