<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="PhoneTimeReportForMemberServices">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=wn000059080;Initial Catalog=MIS_SPOTLIGHT</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>32058bcd-165a-46f4-a5a8-8a7eecccc82f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsStartDate">
      <Query>
        <DataSourceName>PhoneTimeReportForMemberServices</DataSourceName>
        <CommandText>declare @mydate date=(SELECT MAX(Shift_date) FROM GenesysAgentSummaryActivityReport (NOLOCK))
SELECT DATEADD(month, DATEDIFF(month, 0, @mydate), 0) AS StartDate</CommandText>
      </Query>
      <Fields>
        <Field Name="StartDate">
          <DataField>StartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsEndDate">
      <Query>
        <DataSourceName>PhoneTimeReportForMemberServices</DataSourceName>
        <CommandText>declare @mydate date=(SELECT MAX(Shift_date) FROM GenesysAgentSummaryActivityReport (NOLOCK))
SELECT @mydate as EndDate
</CommandText>
      </Query>
      <Fields>
        <Field Name="EndDate">
          <DataField>EndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsLocation">
      <Query>
        <DataSourceName>PhoneTimeReportForMemberServices</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@LineOfBusiness">
            <Value>=Parameters!LineOfBusiness.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT [Location] as Location
FROM LH_WFM_RPT_EMPLOYEE_DEMOGRAPHICS
WHERE [GROUP_L1] IN ('Member Services','Web Tech')
AND LINE_OF_BUSINESS IN (@LineOfBusiness)
AND JOB_DESC LIKE '%Support%' 
AND ROSTER_EFFECTIVE_DATE between @StartDate and @EndDate
ORDER BY [Location]</CommandText>
      </Query>
      <Fields>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsSupervisor">
      <Query>
        <DataSourceName>PhoneTimeReportForMemberServices</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@LineOfBusiness">
            <Value>=Parameters!LineOfBusiness.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT [Supervisor] as Supervisor
FROM LH_WFM_RPT_EMPLOYEE_DEMOGRAPHICS
WHERE [GROUP_L1] IN ('Member Services','Web Tech')
AND LINE_OF_BUSINESS IN (@LineOfBusiness)
AND JOB_DESC LIKE '%Support%' 
AND ROSTER_EFFECTIVE_DATE between @StartDate and @EndDate
ORDER BY [Supervisor]</CommandText>
      </Query>
      <Fields>
        <Field Name="Supervisor">
          <DataField>Supervisor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDeputy_Manager">
      <Query>
        <DataSourceName>PhoneTimeReportForMemberServices</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@LineOfBusiness">
            <Value>=Parameters!LineOfBusiness.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT [Deputy_Manager] as Deputy_Manager
FROM LH_WFM_RPT_EMPLOYEE_DEMOGRAPHICS
WHERE [GROUP_L1] IN ('Member Services','Web Tech')
AND LINE_OF_BUSINESS IN (@LineOfBusiness)
AND JOB_DESC LIKE '%Support%' 
AND ROSTER_EFFECTIVE_DATE between @StartDate and @EndDate
ORDER BY [Deputy_Manager]</CommandText>
      </Query>
      <Fields>
        <Field Name="Deputy_Manager">
          <DataField>Deputy_Manager</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsSummary_View">
      <Query>
        <DataSourceName>PhoneTimeReportForMemberServices</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Location">
            <Value>=Join(Parameters!Location.Value,"!")</Value>
          </QueryParameter>
          <QueryParameter Name="@Supervisor">
            <Value>=Join(Parameters!Supervisor.Value,"!")</Value>
          </QueryParameter>
          <QueryParameter Name="@Deputy_Manager">
            <Value>=Join(Parameters!Deputy_Manager.Value,"!")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EXEC [dbo].[SpotLight_PhoneTimeTracker_Report_OptumRxMembers]
	@StartDate,
	@EndDate,
	'Optum Rx',
	NULL,
	@Location,
	@Supervisor,
	@Deputy_Manager,
	'Summary_View'</CommandText>
      </Query>
