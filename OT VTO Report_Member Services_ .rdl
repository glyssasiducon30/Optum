<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OTVTO_MemberServices">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=wp000125900;Initial Catalog=MIS_SPOTLIGHT</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>96046df6-203c-4e9a-af93-5c3664af2eba</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsStartDate">
      <Query>
        <DataSourceName>OTVTO_MemberServices</DataSourceName>
        <CommandText>declare @mydate date=(SELECT MAX(RPTDATE) FROM SPOTLIGHT_IEX_Automation_Agent_Schedule_Report_DATA_HOURLY (NOLOCK))
SELECT DATEADD(month, DATEDIFF(month, 0, @mydate), 0) AS StartDate</CommandText>
      </Query>
      <Fields>
        <Field Name="StartDate">
          <DataField>StartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsEndDate">
      <Query>
        <DataSourceName>OTVTO_MemberServices</DataSourceName>
        <CommandText>declare @mydate date=(SELECT MAX(RPTDATE) FROM SPOTLIGHT_IEX_Automation_Agent_Schedule_Report_DATA_HOURLY (NOLOCK))
SELECT @mydate as EndDate</CommandText>
      </Query>
      <Fields>
        <Field Name="EndDate">
          <DataField>EndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsLocation">
      <Query>
        <DataSourceName>OTVTO_MemberServices</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>IF OBJECT_ID('tempdb..#DEMO') IS NOT NULL DROP TABLE #DEMO

SELECT 
CASE WHEN LOCATION IS NULL THEN '-' ELSE LOCATION END AS LOCATION
INTO #DEMO
FROM Spotlight_EmployeeInformationDeriveFromLH
WHERE LINE_OF_BUSINESS = 'OPTUM RX'
AND GROUP_L4 = 'PHL PHARMACY MEMBER SRVCES OPT'
AND ROSTER_EFFECTIVE_DATE BETWEEN  @StartDate AND @EndDate
ORDER BY LOCATION

SELECT DISTINCT LOCATION FROM #DEMO</CommandText>
      </Query>
      <Fields>
        <Field Name="LOCATION">
          <DataField>LOCATION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsLOB">
      <Query>
        <DataSourceName>OTVTO_MemberServices</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>IF OBJECT_ID('tempdb..#DEMO') IS NOT NULL DROP TABLE #DEMO

SELECT 
CASE WHEN LINE_OF_BUSINESS IS NULL THEN '-' ELSE LINE_OF_BUSINESS END AS LINE_OF_BUSINESS
INTO #DEMO
FROM Spotlight_EmployeeInformationDeriveFromLH
WHERE LINE_OF_BUSINESS = 'OPTUM RX'
AND GROUP_L4 = 'PHL PHARMACY MEMBER SRVCES OPT'
AND ROSTER_EFFECTIVE_DATE BETWEEN  @StartDate AND @EndDate
ORDER BY LINE_OF_BUSINESS

SELECT DISTINCT LINE_OF_BUSINESS FROM #DEMO</CommandText>
      </Query>
      <Fields>
        <Field Name="LINE_OF_BUSINESS">
          <DataField>LINE_OF_BUSINESS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
