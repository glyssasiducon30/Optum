      <Query>
        <DataSourceName>wp000125900</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT Deputy_Manager
FROM LH_WFM_RPT_EMPLOYEE_DEMOGRAPHICS
WHERE Line_Of_Business = 'Optum Rx'
AND ROSTER_EFFECTIVE_DATE = @StartDate
AND GROUP_L1 IN ('Member Services','Web Tech', 'PHD', 'Specialty Rx')
ORDER BY Deputy_Manager</CommandText>
      </Query>
