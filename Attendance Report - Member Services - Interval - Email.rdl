    <DataSet Name="dsStartDate">
      <Query>
        <DataSourceName>wp000125900</DataSourceName>
        <CommandText>declare @mydate date=(SELECT MAX(RPTDATE) FROM GenesysAgentLoginLogoutDetailsReportMultipleBusiness  (NOLOCK))
SELECT @mydate as Date</CommandText>
      </Query>
      <Fields>
        <Field Name="Date">
          <DataField>Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsLine_Of_Business">
      <Query>
        <DataSourceName>wp000125900</DataSourceName>
        <CommandText>SELECT DISTINCT Group_L1 as Line_Of_Business
FROM LH_WFM_RPT_EMPLOYEE_DEMOGRAPHICS
WHERE Line_Of_Business = 'Optum Rx'
AND GROUP_L1 IN ('Member Services','Web Tech')</CommandText>
      </Query>
      <Fields>
        <Field Name="Line_Of_Business">
          <DataField>Line_Of_Business</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsLocation">
      <Query>
        <DataSourceName>wp000125900</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT Location
FROM LH_WFM_RPT_EMPLOYEE_DEMOGRAPHICS
WHERE Line_Of_Business = 'Optum Rx'
AND ROSTER_EFFECTIVE_DATE = @StartDate
AND GROUP_L1 IN ('Member Services','Web Tech', 'PHD', 'Specialty Rx')
ORDER BY Location</CommandText>
      </Query>
      <Fields>
        <Field Name="Location">
          <DataField>Location</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsSupervisor">
      <Query>
        <DataSourceName>wp000125900</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT Supervisor
FROM LH_WFM_RPT_EMPLOYEE_DEMOGRAPHICS
WHERE Line_Of_Business = 'Optum Rx'
AND ROSTER_EFFECTIVE_DATE = @StartDate
AND GROUP_L1 IN ('Member Services','Web Tech', 'PHD', 'Specialty Rx')
ORDER BY Supervisor</CommandText>
      </Query>
      <Fields>
        <Field Name="Supervisor">
          <DataField>Supervisor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
